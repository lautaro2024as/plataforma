# Variables de entorno para desarrollo local. No subas secretos reales.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-new-random-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_USE_SQLITE=1

# MySQL: se usan cuando DJANGO_USE_SQLITE no está activo.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-with-your-local-database-password
DB_NAME=Plataforma_juegos
